generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Neon: the pooled URL serves queries; schema changes need a direct
  // connection, which Prisma takes from directUrl.
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Booking {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // "session" = booked through the self-serve deposit flow.
  // "invoice" = a one-off custom invoice (e.g. weddings) created from /admin.
  kind String @default("session")

  fullName String
  email    String?
  phone    String
  social   String?

  sessionType String
  packageName String
  sessionDate String
  sessionTime String
  notes       String?
  prints      String?
  // Paid-at-booking extras, e.g. "Rush delivery, Sneak peeks" (Christmas minis).
  addOns      String?

  total       Int
  deposit     Int
  balance     Int
  depositPaid Boolean @default(false)
  paidInFull  Boolean @default(false)
  status      String  @default("confirmed") // confirmed | completed | cancelled

  stripeSessionId       String? @unique
  stripeCustomerId      String?
  stripePaymentIntentId String?
  balanceInvoiceId      String?
  balanceInvoiceUrl     String?

  // Final payment through the site's own payment page, which replaces Stripe
  // invoices for the balance so the client can add an optional tip.
  // paymentToken is the private link (/pay/<token>); it is the only credential
  // the client needs, so it is long and random.
  paymentToken           String?   @unique
  tipEnabled             Boolean   @default(true)
  finalRequestedAt       DateTime?
  finalPaidAt            DateTime?
  tipCents               Int       @default(0)
  finalCheckoutSessionId String?   @unique

  @@map("bookings")
}

// One row per follow-up email sent for a booking. The unique pair is claimed
// before sending, so a retried or overlapping cron run can never send twice.
model EmailLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  bookingId String
  kind      String

  @@unique([bookingId, kind])
  @@map("email_logs")
}

// Inquiries from the contact form and the wedding path on /book. These were
// previously email-only, so anything missed in the inbox was gone for good.
model Inquiry {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name          String
  email         String
  phone         String?
  sessionType   String
  preferredDate String?
  message       String

  // new | contacted | booked | lost
  status     String  @default("new")
  adminNotes String?

  // False when the notification email failed but the inquiry was still saved.
  emailSent Boolean @default(true)

  @@index([createdAt])
  @@map("inquiries")
}

// Reserves one fixed-time mini slot while its client is in Stripe Checkout,
// so two families can't pay for the same time. The primary key is the slot
// itself, which makes "only one live hold per slot" a database guarantee.
model SlotHold {
  slotKey         String   @id
  createdAt       DateTime @default(now())
  expiresAt       DateTime
  // Secret in the Checkout cancel URL; lets that client release the hold.
  releaseKey      String
  stripeSessionId String?
  // Who holds it, to cap how many slots one visitor can tie up.
  ip              String?
  // Random per-browser secret (HttpOnly cookie) proving a later request
  // comes from the same browser that started this checkout.
  owner           String?

  @@map("slot_holds")
}
