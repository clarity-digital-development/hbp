generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Neon: the pooled URL serves queries; schema changes need a direct
  // connection, which Prisma takes from directUrl.
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Booking {
  id                    String   @id @default(cuid())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // "session" = booked through the self-serve deposit flow.
  // "invoice" = a one-off custom invoice (e.g. weddings) created from /admin.
  kind                  String   @default("session")

  fullName              String
  email                 String?
  phone                 String
  social                String?

  sessionType           String
  packageName           String
  sessionDate           String
  sessionTime           String
  notes                 String?
  prints                String?

  total                 Int
  deposit               Int
  balance               Int
  depositPaid           Boolean  @default(false)
  paidInFull            Boolean  @default(false)
  status                String   @default("confirmed") // confirmed | completed | cancelled

  stripeSessionId       String?  @unique
  stripeCustomerId      String?
  stripePaymentIntentId String?
  balanceInvoiceId      String?
  balanceInvoiceUrl     String?

  @@map("bookings")
}

// Inquiries from the contact form and the wedding path on /book. These were
// previously email-only, so anything missed in the inbox was gone for good.
model Inquiry {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  name        String
  email       String
  phone       String?
  sessionType String
  preferredDate String?
  message     String

  // new | contacted | booked | lost
  status      String   @default("new")
  adminNotes  String?

  // False when the notification email failed but the inquiry was still saved.
  emailSent   Boolean  @default(true)

  @@index([createdAt])
  @@map("inquiries")
}
